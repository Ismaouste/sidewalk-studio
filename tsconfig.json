{
    "$schema": "https://json.schemastore.org/tsconfig",
    // Solution-style root config. It owns no files itself: `tsconfig.app.json`
    // type-checks browser code and `tsconfig.node.json` type-checks the build
    // tooling, so Node globals never leak into components and DOM globals never
    // leak into Vite config. `npm run types:check` builds both.
    "files": [],
    "references": [
        { "path": "./tsconfig.app.json" },
        { "path": "./tsconfig.node.json" }
    ]
}
