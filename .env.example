APP_NAME="Ismael Rodmacq"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8088
SITE_PUBLIC_URL=http://127.0.0.1:8088
SITE_URL_PLACEHOLDER="{{site_url}}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=database/database.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
SITE_SETTINGS_SOURCE=files
SITE_NAME="Ismael Rodmacq"
SITE_TAGLINE="Full-stack e-commerce. Cross-functional data, reliable flows."
SITE_DESCRIPTION="Full-stack web development for e-commerce, product-data flows, CMS delivery, consent-aware tracking, and technical SEO."
SITE_AUTHOR_NAME="Ismael Rodmacq"
SITE_AUTHOR_TITLE="Full-stack e-commerce developer for product data, integrations, tracking, and technical SEO"
SITE_CONTACT_EMAIL="ismael@rodmacq.com"
SITE_SAME_AS="https://github.com/Ismaouste,https://www.linkedin.com/in/ismaelrodmacq"
ADMIN_SEED_EMAIL="admin@sidewalk-studio.test"
ADMIN_SEED_NAME="Sidewalk Admin"
ADMIN_SEED_PASSWORD="change-me-local"
CONSENT_MODE=strict
ANALYTICS_DRIVER=none
CONSENT_COOKIE_NAME=sidewalk_consent

# Inertia DevTools records one payload per request to disk and injects a script
# into every response. Off by default so it never leaks into the static preview
# export; set to true when you want to inspect visits with the Chrome extension.
INERTIA_DEVTOOLS_ENABLED=false
