{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build",
    "framework": null,
    "version": 2,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/",
            "destination": "/api/index.php"
        },
        {
            "source": "/:path*",
            "destination": "/api/index.php"
        }
    ]
}
