{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "audit:bundle": "vite build --mode analyze",
        "audit:lighthouse": "lighthouse http://127.0.0.1:8088 --preset=desktop --output=html --output-path=./storage/app/lighthouse-report.html --chrome-flags=\"--headless=new\"",
        "audit:lighthouse:mobile": "lighthouse http://127.0.0.1:8088 --preset=perf --form-factor=mobile --screenEmulation.mobile --output=html --output-path=./storage/app/lighthouse-report-mobile.html --chrome-flags=\"--headless=new\"",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "check": "npm run lint:check && npm run format:check && npm run types:check",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "vue-tsc --build",
        "vercel-build": "npm run build",
        "vercel-build:local": "php -r \"if (! is_dir('database')) { mkdir('database', 0777, true); } if (! file_exists('database/database.sqlite')) { touch('database/database.sqlite'); }\" && php artisan migrate:fresh --seed --force && npm run build"
    },
    "dependencies": {
        "@fontsource/dm-mono": "^5.3.0",
        "@fontsource/dm-sans": "^5.3.0",
        "@fontsource/fraunces": "^5.3.0",
        "@fontsource/syne": "^5.3.0",
        "@inertiajs/vue3": "^3.7.0",
        "@orestbida/iframemanager": "^1.3.0",
        "vanilla-cookieconsent": "^3.1.0",
        "vue": "^3.5.42",
        "web-vitals": "^6.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.4.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-vue": "^10.10.0",
        "fontaine": "^0.8.1",
        "laravel-vite-plugin": "^3.2.0",
        "lighthouse": "^13.4.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-visualizer": "^7.1.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@rolldown/binding-linux-x64-gnu": "^1.2.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    }
}
